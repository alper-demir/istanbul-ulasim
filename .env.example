# The official service currently accepts an empty AuthHeader. If IETT assigns
# credentials later, keep them server-side with these optional variables.
IETT_LIVE_USERNAME=
IETT_LIVE_PASSWORD=

# Optional live-data tuning. A zero hourly limit disables the application-side
# budget; the IETT service can still enforce its own limits.
IETT_LIVE_CACHE_TTL_MS=45000
IETT_LIVE_STALE_TTL_MS=600000
IETT_LIVE_TIMEOUT_MS=10000
IETT_LIVE_FAILURE_BACKOFF_MS=15000
IETT_LIVE_MAX_REQUESTS_PER_HOUR=360
IETT_LIVE_MAX_CACHE_ENTRIES=900
IETT_LIVE_MAX_RESPONSE_BYTES=1000000

# Public production URL, used only for canonical/share metadata. Do not add a
# trailing slash. Secrets continue to be managed by the hosting environment.
NEXT_PUBLIC_SITE_URL=https://istanbulum.example
